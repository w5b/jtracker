{
  "name": "jtracker",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "hpack.js": "2.1.6",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "engine.io-client": "6.6.6",
    "engine.io-parser": "5.2.3",
    "koffi": "3.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tldts": "7.0.25",
    "tough-cookie": "6.0.0",
    "ws": "8.21.3"
  },
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./socketio": {
      "types": "./src/socketio.d.ts",
      "import": "./src/socketio.js"
    }
  },
  "engines": {
    "node": ">=22.15",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "setup": "node scripts/setup-native.js",
    "test": "node --experimental-strip-types --test test/*.test.js",
    "validate": "node validation/run.js",
    "example": "node examples/local.js",
    "jtracker": "node --experimental-strip-types JTracker.ts",
    "jtracker:bun": "bun JTracker.ts",
    "check": "tsc --noEmit"
  }
}
